<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PACKAGE_USAGE_STATS는 일반 런타임 권한이 아니다.
        requestPermissions()로 받을 수 없고, 사용자가 시스템 설정의
        "사용 정보 접근" 화면에서 직접 허용해야 한다.
        UsagePermissionChecker가 AppOps로 실제 허용 여부를 확인한다.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        UID를 앱 이름으로 바꾸려면 설치된 패키지를 조회할 수 있어야 한다.
        Play 스토어 배포 시에는 정당화 사유 제출이 필요하다.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        사용량 경고 알림용. Android 13(API 33)부터 런타임 권한이라
        설정 화면에서 사용자에게 요청한다.
    -->
    <!--
        이 앱은 사용 기록을 밖으로 보내지 않는다. 이 권한은 **받는 쪽으로만** 쓴다.
        설정 화면에서 "새 버전이 나왔는지"를 묻는 HTTPS 요청 한 번이 전부이고,
        그 요청에는 기기나 사용량에 관한 정보가 실리지 않는다.
        확인 주소가 빌드에 설정되지 않으면 요청 자체가 일어나지 않는다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        새 버전 APK를 앱 안에서 받아 설치 화면까지 띄우기 위해 필요하다.
        이 권한만으로는 설치되지 않는다 — 사용자가 시스템 설정에서 이 앱에
        "출처를 알 수 없는 앱 설치"를 따로 허용해야 하고, 설치 화면도 반드시 뜬다.
        브라우저로 넘기는 방식은 실기기에서 설치가 막혀(받은 파일을 다시 열어야 했다)
        이 경로를 골랐다.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TracePhoneApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TracePhone">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TracePhone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hilt가 WorkerFactory를 주입하려면 WorkManager의 기본 자동 초기화를 꺼야 한다.
            초기화는 TracePhoneApplication이 Configuration.Provider로 담당한다.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            홈 화면 위젯. 시스템이 만들고 갱신하므로 exported=true여야 한다.
            내부 데이터를 외부로 내보내지 않고, 표시할 값은 앱이 직접 계산해 그린다.
        -->
        <receiver
            android:name=".widget.TracePhoneWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tracephone_widget_info" />
        </receiver>

        <!--
            받은 APK를 시스템 설치 화면에 넘기는 통로.

            안드로이드 7부터 file:// 주소를 다른 앱에 넘길 수 없어 이것이 필요하다.
            exported=false이므로 다른 앱이 이 제공자를 직접 열 수는 없고, 설치 프로그램은
            인텐트에 실어 보낸 일회성 읽기 권한으로만 파일을 본다.
            열어 주는 범위는 @xml/file_paths가 정한 캐시의 apk/ 폴더 하나뿐이다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
